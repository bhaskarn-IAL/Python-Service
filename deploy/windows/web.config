<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional: use IIS only as a reverse proxy to the FastAPI control API that
  the Windows Service exposes on http://localhost:8000. IIS must NOT host
  the workers themselves - it recycles app pools and kills idle processes,
  which would break long-running units.

  Requires Application Request Routing (ARR) and URL Rewrite modules:
    https://www.iis.net/downloads/microsoft/application-request-routing
    https://www.iis.net/downloads/microsoft/url-rewrite

  Enable the proxy in ARR once per server:
    Import-Module WebAdministration
    Set-WebConfigurationProperty -PSPath 'MACHINE/WEBROOT/APPHOST' `
      -Filter 'system.webServer/proxy' -Name enabled -Value true
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToMyService" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="{CACHE_URL:0,5}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
